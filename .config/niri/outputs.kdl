output "eDP-1" {
    scale 1.8
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "3840x2160@143.851"
    scale 2
    position x=0 y=0
}

output "HDMI-A-5" {
    mode "3840x2160@143.851"
    scale 2
    position x=0 y=0
}

output "DP-1" {
    scale 2
    position x=-1920 y=-216
}

output "DP-3" {
    scale 1
    position x=-1920 y=-216
}
